      "name": "Egg White, Spinach & Black Bean Burrito",
      "description": "Freezer breakfast burritos: egg whites, spinach, black beans, cheddar and salsa in a high-fiber tortilla, with Greek yogurt for dipping.",
      "recipeCategory": "combo",
      "recipeCuisine": "mexican",
      "mp:format": "wrap",
      "mp:meal": "breakfast",
      "mp:assembleAtPrep": true,
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "Warm the tortillas in a dry skillet so they fold without cracking."
        },
        {
          "@type": "HowToStep",
          "text": "Fill each with the egg whites, spinach, beans, cheddar and salsa. Fold in the sides and roll tightly."
        },
        {
          "@type": "HowToStep",
          "text": "Cool completely, wrap each in foil and freeze."
        },
        {
          "@type": "HowToStep",
          "text": "Portion the Greek yogurt into small containers for dipping and refrigerate."
        },
        {
          "@type": "HowToStep",
          "text": "To eat: unwrap, wrap in a paper towel and microwave 2 minutes. Dip in the yogurt."
