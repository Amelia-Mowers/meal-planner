        {
          "@type": "HowToStep",
          "text": "Heat a nonstick skillet over medium heat and wipe it with the oil."
        },
        {
          "@type": "HowToStep",
          "text": "Cook ¼-cup pancakes until the bubbles on top set, about 2 minutes; flip and cook 1 minute more."
        },
        {
          "@type": "HowToStep",
          "text": "Cool on a rack. Stack with parchment between and freeze; reheat in the toaster."
