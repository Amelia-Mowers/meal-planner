    {
      "@type": "Recipe",
      "@id": "comp/chicken-rotisserie",
      "name": "Shredded rotisserie chicken",
      "alternateName": "Rotisserie chicken",
      "description": "Store-bought rotisserie chicken, skin off, pulled into bite-size shreds. Zero cooking.",
      "recipeCategory": "protein",
      "recipeCuisine": [
        "neutral"
      ],
      "mp:formats": [
        "bowl",
        "wrap"
      ],
      "mp:portion": {
        "@type": "QuantitativeValue",
        "value": 150,
        "unitCode": "GRM"
      },
      "mp:portionRange": {
        "minValue": 100,
        "maxValue": 200
      },
      "recipeYield": {
        "@type": "QuantitativeValue",
        "value": 750,
        "unitCode": "GRM"
      },
      "recipeIngredient": [
        "1 rotisserie chicken, skin removed, shredded"
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "rotisserie chicken",
          "description": "skin removed, shredded",
          "identifier": "food/rotisserie-chicken",
          "requiredQuantity": {
            "@type": "QuantitativeValue",
            "value": 1,
            "unitText": "whole"
          }
        }
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "While still warm, pull off and discard the skin."
        },
        {
          "@type": "HowToStep",
          "text": "Shred the breast and thigh meat with two forks; discard bones and cartilage."
        },
        {
          "@type": "HowToStep",
          "text": "Cool uncovered for 15 minutes, then refrigerate in a shallow container."
        }
      ],
      "prepTime": "PT15M",
      "totalTime": "PT15M",
      "author": {
        "@type": "Organization",
