      "@type": "Recipe",
      "@id": "comp/chicken-rotisserie",
      "name": "Shredded rotisserie chicken",
      "alternateName": "Rotisserie chicken",
      "description": "Store-bought rotisserie chicken, skin off, pulled into bite-size shreds. Zero cooking.",
      "recipeCategory": "protein",
      "recipeCuisine": [
        "neutral"
      ],
      "mp:formats": [
        "bowl",
        "wrap"
      ],
