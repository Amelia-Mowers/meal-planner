{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amelia-mowers.github.io/meal-planner/schema/recipe.schema.json",
  "title": "Meal Planner Recipe (component or combo)",
  "description": "A schema.org Recipe as JSON-LD, with mp: extensions for component-based meal prep.",
  "type": "object",
  "required": ["@type", "@id", "name", "recipeCategory", "supply"],
  "properties": {
    "@type": { "const": "Recipe" },
    "@id": { "type": "string", "pattern": "^(comp|combo)/[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "recipeCategory": { "enum": ["protein", "base", "veg", "sauce", "topper", "combo"] },
    "recipeCuisine": {
      "oneOf": [
        { "$ref": "#/$defs/cuisine" },
        { "type": "array", "items": { "$ref": "#/$defs/cuisine" }, "minItems": 1 }
      ]
    },
    "recipeIngredient": { "type": "array", "items": { "type": "string" } },
    "recipeYield": { "$ref": "#/$defs/quantity" },
    "supply": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/supply" } },
    "tool": { "type": "array", "items": { "type": "object", "required": ["@type", "name"], "properties": { "@type": { "const": "HowToTool" }, "name": { "type": "string" } } } },
    "recipeInstructions": { "type": "array", "items": { "type": "object", "required": ["@type", "text"], "properties": { "@type": { "const": "HowToStep" }, "text": { "type": "string" } } } },
    "prepTime": { "$ref": "#/$defs/duration" },
    "cookTime": { "$ref": "#/$defs/duration" },
    "totalTime": { "$ref": "#/$defs/duration" },
    "keywords": { "type": "string" },
    "author": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } },
    "license": { "type": "string", "pattern": "^https?://" },
    "isBasedOn": {},
    "mp:formats": { "type": "array", "items": { "$ref": "#/$defs/format" }, "minItems": 1, "uniqueItems": true },
    "mp:format": { "$ref": "#/$defs/format" },
    "mp:portion": { "$ref": "#/$defs/quantity" },
    "mp:portionRange": {
      "type": "object",
      "required": ["minValue", "maxValue"],
      "properties": { "minValue": { "type": "number", "exclusiveMinimum": 0 }, "maxValue": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "mp:tested": { "type": "boolean" },
    "mp:needsReview": { "type": "boolean" },
    "mp:fridgeDays": { "type": ["integer", "null"], "minimum": 0 },
    "mp:freezable": { "type": "boolean" },
    "mp:serve": { "enum": ["hot", "cold", "either"] },
    "mp:secondary": { "type": "boolean" },
    "mp:batchGroup": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "recipeCategory": { "const": "combo" } } },
      "then": { "required": ["mp:format"] },
      "else": { "required": ["mp:portion", "recipeYield", "mp:formats", "recipeCuisine", "recipeIngredient"] }
    }
  ],
  "$defs": {
    "cuisine": { "enum": ["mexican", "mediterranean", "east-asian", "italian", "neutral"] },
    "format": { "enum": ["bowl", "wrap"] },
    "duration": { "type": "string", "pattern": "^P(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+S)?)?$" },
    "quantity": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "@type": { "const": "QuantitativeValue" },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unitCode": { "type": "string", "pattern": "^[A-Z0-9]{3}$" },
        "unitText": { "type": "string" }
      },
      "oneOf": [{ "required": ["unitCode"] }, { "required": ["unitText"] }]
    },
    "supply": {
      "type": "object",
      "required": ["@type", "identifier"],
      "properties": {
        "@type": { "const": "HowToSupply" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "identifier": { "type": "string", "pattern": "^(food|comp)/[a-z0-9][a-z0-9-]*$" },
        "requiredQuantity": { "$ref": "#/$defs/quantity" }
      }
    }
  }
}
